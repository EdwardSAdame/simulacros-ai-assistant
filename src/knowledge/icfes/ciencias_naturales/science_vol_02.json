              "optionAiDescription": ""
            },
            {
              "optionId": "C",
              "type": "text",
              "content": "Se deberían mostrar datos del líquido usado y su viscosidad.",
              "optionAiDescription": ""
            },
            {
              "optionId": "D",
              "type": "text",
              "content": "Se debería mantener constante la fuerza magnética.",
              "optionAiDescription": ""
